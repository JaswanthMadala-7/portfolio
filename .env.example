# Public site URL (no trailing slash). Replace once you own a domain.
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN.example

# Contact form email delivery via Resend (https://resend.com). Server-only; never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional: set to "true" on preview/staging deployments to block indexing.
NOINDEX=
